# Ethereum mainnet JSON-RPC endpoint. Any provider works.
ETH_RPC_URL=https://<your-rpc-provider>

# Comma-separated list of the attestor BETH supply endpoints, as full URLs.
# BitSafe shares this list with you directly. It is not part of this repository.
ATTESTOR_SUPPLY_URLS=https://<attestor-1>/<path>,https://<attestor-2>/<path>
